# ============================================================
# DecodeLabs GenAI Project — API Keys Template
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your actual keys below
# 3. NEVER commit your real .env file to GitHub!
# ============================================================

# Groq API (free tier available) — used in Task 1, 3, 4
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API — used in Task 4 (optional), Task 5
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API (optional, for Claude) — used in Task 1 demo
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
